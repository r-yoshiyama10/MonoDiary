# ローカルで Postman から試す場合の例（このファイルを .env にコピーして値を入れてください）
GEMINI_API_KEY=
MONODIARY_ENABLE_DEV_ROUTES=true
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/monodiary?sslmode=disable

# LINE Messaging API（LINE Developers Console で取得）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login（LINE Developers Console のログインチャネルから取得）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:8080/auth/line/callback

# セッション（openssl rand -base64 32 などで生成した32バイト以上のランダム文字列）
SESSION_SECRET=

# フロントエンド（ローカル開発時は Vite のデフォルトポート）
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173

# アクセス制限（自分のLINE User ID を設定。空なら誰でも使える）
LINE_ALLOWED_USER_ID=

# 利用不可なら gemini-2.0-flash や gemini-1.5-flash へ（詳細設計 6.2）
# GEMINI_MODEL=gemini-2.5-flash


# ngrok（https://dashboard.ngrok.com/get-started/your-authtoken で取得）
NGROK_AUTHTOKEN=